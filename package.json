{
    "name": "condologpro",
    "version": "0.1.0",
    "private": true,
    "description": "Local-first MVP for condominium package management.",
    "scripts": {
        "dev": "next dev",
        "dev:host": "next dev -H 0.0.0.0",
        "build": "next build",
        "start": "next start",
        "typecheck": "tsc --noEmit",
        "prisma:validate": "prisma validate",
        "prisma:generate": "prisma generate",
        "prisma:push": "prisma db push",
        "prisma:supabase:validate": "prisma validate --schema prisma/schema.supabase.prisma",
        "prisma:supabase:generate": "prisma generate --schema prisma/schema.supabase.prisma",
        "prisma:supabase:push": "prisma db push --schema prisma/schema.supabase.prisma",
        "prisma:seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.4.0",
        "@prisma/client": "^6.19.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.17.0",
        "next": "^16.2.6",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-hook-form": "^7.76.1",
        "tailwind-merge": "^3.6.0",
        "tesseract.js": "^7.0.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.0",
        "@types/node": "^25.9.1",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "prisma": "^6.19.3",
        "tailwindcss": "^4.3.0",
        "tsx": "^4.22.3",
        "typescript": "^6.0.3"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    }
}
