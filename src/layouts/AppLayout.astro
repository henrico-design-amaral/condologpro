---
import '../styles/condologpro.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CondoLogPro — Gestão operacional de encomendas',
  description = 'Recebimento, identificação, comunicação e retirada de encomendas com rastreabilidade para condomínios.'
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#151313" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
