---
import '../styles/condologpro.css';
import '../styles/henricoops-theme.css';

const flow = [
  ['01', 'Fotografe', 'A portaria registra a etiqueta pelo celular, sem depender de caderno ou planilha.'],
  ['02', 'Identifique', 'O sistema ajuda a localizar bloco, apartamento e morador, sempre com revisão humana.'],
  ['03', 'Avise', 'A comunicação fica pronta para envio, sem mensagens improvisadas ou moradores esquecidos.'],
  ['04', 'Entregue', 'A retirada é confirmada com horário, responsável e histórico consultável.']
];

const audiences = [
  ['Portaria', 'Menos busca manual, menos papel e uma rotina que continua funcionando mesmo quando a etiqueta está ruim.'],
  ['Síndico', 'Visibilidade sobre pendências, retiradas e ocorrências sem depender da memória de ninguém.'],
  ['Administradora', 'Um processo replicável, auditável e mais fácil de acompanhar entre diferentes condomínios.'],
  ['Morador', 'Avisos mais rápidos e menos desencontro na hora de buscar uma encomenda.']
];

const faq = [
  ['O CondoLogPro substitui o WhatsApp?', 'Não necessariamente. Ele organiza o recebimento e prepara a comunicação, permitindo manter um canal familiar sem perder o controle do processo.'],
  ['E se a etiqueta não for reconhecida?', 'A operação continua. O porteiro pode revisar, corrigir ou preencher os dados manualmente. A automação ajuda, mas nunca bloqueia.'],
  ['Funciona no celular da portaria?', 'Sim. O fluxo de entrada foi desenhado para câmera mobile, alvos grandes e uso rápido durante a rotina real.'],
  ['É possível consultar o histórico?', 'Sim. Cada pacote mantém uma linha do tempo com entrada, associação, aviso e retirada.']
];
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="CondoLogPro organiza recebimento, identificação, aviso e retirada de encomendas em condomínios." />
    <link rel="canonical" href="https://condologpro.henrico.works/" />
    <meta name="theme-color" content="#050608" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CondoLogPro" />
    <meta property="og:title" content="CondoLogPro — Controle operacional de encomendas" />
    <meta property="og:description" content="Receba, identifique, avise e registre a retirada de encomendas em um único fluxo para portarias e condomínios." />
    <meta property="og:url" content="https://condologpro.henrico.works/" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="CondoLogPro — Controle operacional de encomendas" />
    <meta name="twitter:description" content="Receba, identifique, avise e registre a retirada de encomendas em um único fluxo para portarias e condomínios." />
    <title>CondoLogPro — Controle operacional para encomendas</title>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
    <div class="scroll-progress" aria-hidden="true"><span></span></div>

    <header class="header" data-header>
      <div class="shell header-inner">
        <a class="brand" href="#top" aria-label="CondoLogPro, início">condolog<i>pro</i></a>
        <nav class="nav" aria-label="Navegação principal">
          <a href="#produto">Produto</a>
          <a href="#como-funciona">Como funciona</a>
          <a href="#seguranca">Segurança</a>
          <a class="nav-cta" href="#demonstracao">Agendar demonstração</a>
        </nav>
      </div>
    </header>

    <main id="conteudo">
      <section class="hero section" id="top">
        <div class="hero-orbit" aria-hidden="true"></div>
        <div class="shell hero-grid">
          <div class="hero-copy reveal">
            <p class="kicker">Portaria mobile · painel operacional · histórico auditável</p>
            <h1>Encomendas sob controle. Do recebimento à retirada.</h1>
            <p class="lead">Fotografe a etiqueta, identifique o morador, prepare o aviso e registre a entrega em um único fluxo — direto do celular da portaria e com visão operacional para quem precisa acompanhar.</p>
            <div class="actions">
              <a class="button primary" href="#demonstracao">Quero uma demonstração <span aria-hidden="true">→</span></a>
              <a class="button secondary" href="#produto">Ver o produto <span aria-hidden="true">↓</span></a>
            </div>
            <ul class="trust-list" aria-label="Princípios do produto">
              <li>Sem depender de papel</li>
              <li>Automação com correção humana</li>
              <li>Histórico consultável</li>
            </ul>
          </div>

          <aside class="product-stage reveal reveal-delay" aria-label="Demonstração visual do fluxo de recebimento">
            <div class="stage-label"><span>Interface demonstrativa</span><span class="live-dot">Fluxo ativo</span></div>
            <div class="device">
              <div class="device-top"><strong>Nova encomenda</strong><span>09:41</span></div>
              <div class="camera-frame"><span class="scan-line"></span><small>Etiqueta detectada</small></div>
              <div class="recognition-card"><span>Morador encontrado</span><strong>Ana Beatriz · Bloco 12 · 1203</strong></div>
              <div class="timeline-mini"><span class="done">Recebida</span><span class="done">Identificada</span><span>Notificar</span></div>
              <div class="device-action">Confirmar entrada <span aria-hidden="true">→</span></div>
            </div>
            <div class="floating-event" aria-hidden="true">
              <span>09:44</span>
              <strong>Aviso preparado</strong>
              <small>Pronto para revisão da portaria</small>
            </div>
            <div class="stage-note">A tecnologia acelera. A decisão continua sendo humana.</div>
          </aside>
        </div>

        <div class="shell operational-loop reveal" aria-label="Fluxo operacional resumido">
          <div class="loop-label"><span>/ Fluxo operacional</span><strong>Uma única linha do tempo</strong></div>
          <ol>
            <li><span>01</span><strong>Recebida</strong><small>foto + horário</small></li>
            <li><span>02</span><strong>Identificada</strong><small>unidade + morador</small></li>
            <li><span>03</span><strong>Notificada</strong><small>aviso revisado</small></li>
            <li><span>04</span><strong>Retirada</strong><small>responsável + registro</small></li>
          </ol>
        </div>
      </section>

      <section class="problem section">
        <div class="shell problem-grid">
          <div class="section-copy reveal">
            <p class="kicker">O problema não é receber</p>
            <h2>É saber exatamente o que aconteceu depois.</h2>
          </div>
          <div class="problem-list reveal reveal-delay">
            <p>Papel se perde.</p>
            <p>Planilha fica desatualizada.</p>
            <p>Mensagem no WhatsApp some.</p>
            <p>A memória falha.</p>
            <strong>Quando algo dá errado, ninguém deveria precisar reconstruir a história.</strong>
          </div>
        </div>
      </section>

      <section class="section" id="como-funciona">
        <div class="shell section-head reveal"><p>/ Como funciona</p><i></i><span>Um fluxo simples para uma operação que nunca foi simples</span></div>
        <div class="shell flow-grid">
          {flow.map(([number, title, text]) => (
            <article class="flow-step reveal">
              <span>{number}</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section product-proof" id="produto">
        <div class="shell proof-grid">
          <div class="dashboard-card reveal">
            <div class="dashboard-top"><span>Painel operacional</span><span class="demo-badge">Dados ilustrativos</span></div>
            <div class="dashboard-shell">
              <div class="dashboard-rail" aria-hidden="true">
                <span class="rail-mark">clp</span>
                <i class="active"></i><i></i><i></i><i></i>
              </div>
              <div class="dashboard-main">
                <div class="metrics">
                  <div><strong>38</strong><span>encomendas ativas</span></div>
                  <div><strong>07</strong><span>exigem atenção</span></div>
                  <div><strong>12</strong><span>retiradas hoje</span></div>
                </div>
                <div class="package-list">
                  <div><b>BPX71A8BR</b><span>Ana Beatriz · aguardando retirada</span><em>Notificada</em></div>
                  <div><b>PLM93K2BR</b><span>Carlos Mendes · bloco 8</span><em class="attention">Atenção</em></div>
                  <div><b>QTR18N4BR</b><span>Marina Souza · retirada concluída</span><em>Entregue</em></div>
                </div>
              </div>
            </div>
          </div>
          <div class="section-copy reveal reveal-delay">
            <p class="kicker">Visibilidade operacional</p>
            <h2>Veja o que exige atenção. Não apenas o que existe.</h2>
            <p class="lead">O painel transforma uma lista de volumes em uma visão clara de pendências, avisos, retiradas e ocorrências — sem transformar a portaria em operadora de sistema.</p>
            <div class="proof-note"><span>01</span><p>Fila de trabalho legível para a portaria.</p></div>
            <div class="proof-note"><span>02</span><p>Estados operacionais claros para síndico e administradora.</p></div>
          </div>
        </div>
      </section>

      <section class="section surfaces-section">
        <div class="shell section-head reveal"><p>/ Duas superfícies</p><i></i><span>Entrada rápida na portaria, visão ampla na administração</span></div>
        <div class="shell surface-grid">
          <article class="surface-card surface-mobile reveal">
            <div class="surface-copy">
              <span>01 · Mobile intake</span>
              <h3>Feito para entrar no fluxo da portaria.</h3>
              <p>Câmera primeiro, campos grandes e revisão humana quando o reconhecimento não for suficiente.</p>
            </div>
            <div class="mini-phone" aria-label="Simulação da tela mobile de nova encomenda">
              <div class="mini-phone-top"><span>Nova encomenda</span><i></i></div>
              <div class="mini-camera"><b>Etiqueta</b><small>enquadre para identificar</small></div>
              <div class="mini-field"><small>Morador</small><strong>Ana Beatriz</strong></div>
              <div class="mini-field muted"><small>Unidade</small><strong>Bloco 12 · 1203</strong></div>
              <div class="mini-confirm">Revisar e confirmar</div>
            </div>
          </article>

          <article class="surface-card surface-admin reveal reveal-delay">
            <div class="surface-copy">
              <span>02 · Operação</span>
              <h3>Feito para descobrir o que precisa de ação.</h3>
              <p>Uma camada de acompanhamento para pendências, avisos, retiradas e histórico operacional.</p>
            </div>
            <div class="mini-board" aria-label="Simulação do painel operacional">
              <div class="mini-board-top"><span>Fila de encomendas</span><small>hoje</small></div>
              <div class="mini-row"><i class="ok"></i><strong>Ana Beatriz</strong><span>Notificada</span></div>
              <div class="mini-row"><i class="warn"></i><strong>Carlos Mendes</strong><span>Revisar unidade</span></div>
              <div class="mini-row"><i class="done"></i><strong>Marina Souza</strong><span>Entregue</span></div>
            </div>
          </article>
        </div>
      </section>

      <section class="section">
        <div class="shell section-head reveal"><p>/ Valor para todos</p><i></i><span>Uma operação melhor percebida por toda a cadeia</span></div>
        <div class="shell audience-grid">
          {audiences.map(([title, text]) => (
            <article class="audience-card reveal"><h3>{title}</h3><p>{text}</p></article>
          ))}
        </div>
      </section>

      <section class="section safety" id="seguranca">
        <div class="shell safety-grid">
          <div class="section-copy reveal">
            <p class="kicker">Automação sem armadilha</p>
            <h2>O sistema ajuda. A portaria mantém o controle.</h2>
            <p class="lead">Etiqueta amassada, informação incompleta ou morador não encontrado não podem paralisar a operação.</p>
          </div>
          <div class="safety-points reveal reveal-delay">
            <div><span>01</span><p>Todo reconhecimento pode ser revisado antes da confirmação.</p></div>
            <div><span>02</span><p>Todo campo pode ser corrigido manualmente.</p></div>
            <div><span>03</span><p>Todo pacote mantém um histórico de ações e responsáveis.</p></div>
          </div>
        </div>
      </section>

      <section class="section evidence">
        <div class="shell evidence-grid">
          <div class="section-copy reveal">
            <p class="kicker">Rastreabilidade</p>
            <h2>Cada encomenda conta uma história.</h2>
            <p class="lead">Não é só saber que o pacote existe. É conseguir entender quem registrou, quando foi associado, quando o aviso ficou pronto e como a retirada terminou.</p>
          </div>
          <ol class="timeline reveal reveal-delay">
            <li><time>09:41</time><div><strong>Entrada registrada</strong><span>Foto da etiqueta anexada</span></div></li>
            <li><time>09:43</time><div><strong>Morador associado</strong><span>Ana Beatriz · Bloco 12 · 1203</span></div></li>
            <li><time>09:44</time><div><strong>Aviso preparado</strong><span>Comunicação revisada pela portaria</span></div></li>
            <li><time>14:20</time><div><strong>Retirada concluída</strong><span>Entrega registrada por Marcos Silva</span></div></li>
          </ol>
        </div>
      </section>

      <section class="section faq-section">
        <div class="shell faq-grid">
          <div class="section-copy reveal"><p class="kicker">Perguntas frequentes</p><h2>O que precisa estar claro antes de começar.</h2></div>
          <div class="faq-list reveal reveal-delay">
            {faq.map(([question, answer]) => (
              <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>
            ))}
          </div>
        </div>
      </section>

      <section class="section cta-section" id="demonstracao">
        <div class="shell cta-card reveal">
          <p class="kicker">Demonstração orientada à sua realidade</p>
          <h2>Sua portaria já recebe encomendas todos os dias.</h2>
          <p>A decisão agora é continuar improvisando ou começar a controlar.</p>
          <a class="button primary large" href="mailto:contato@henrico.works?subject=Quero conhecer o CondoLogPro">Quero conhecer o CondoLogPro <span aria-hidden="true">→</span></a>
          <small>Sem formulário e sem captura de dados nesta versão. O contato abre diretamente no seu cliente de e-mail.</small>
        </div>
      </section>
    </main>

    <footer class="footer"><div class="shell"><a class="brand" href="#top">condolog<i>pro</i></a><p>Menos improviso na portaria.</p></div></footer>

    <script is:inline>
      document.documentElement.classList.add('js-enabled');
      const header = document.querySelector('[data-header]');
      const progress = document.querySelector('.scroll-progress span');
      const update = () => {
        header?.classList.toggle('is-scrolled', scrollY > 20);
        const max = document.documentElement.scrollHeight - innerHeight;
        if (progress) progress.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
      };
      addEventListener('scroll', update, { passive: true });
      update();
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
          if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
        }), { threshold: .12 });
        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      } else {
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
