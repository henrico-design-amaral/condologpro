{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.astro",
    "src/**/*.ts",
    "astro.config.mjs"
  ],
  "exclude": [
    "node_modules",
    "src/app",
    "src/components",
    "prisma",
    ".next",
    "dist"
  ]
}
