# Public browser configuration. These values identify the Supabase project and
# are safe to ship only because every table and Storage object is protected by RLS.
PUBLIC_SUPABASE_URL="https://project-ref.supabase.co"
PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"

# Optional local-only service key used by scripts/seed-supabase-users.ts.
# Never expose it with a PUBLIC_ prefix and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=""

# Test identities for a local or isolated preview project only.
E2E_ADMIN_EMAIL="admin@condologpro.local"
E2E_FRONT_DESK_EMAIL="portaria@condologpro.local"
E2E_SECOND_OPERATOR_EMAIL="portaria-2@condologpro.local"
E2E_TENANT_B_EMAIL="portaria-isolada@condologpro.local"
E2E_INACTIVE_EMAIL="inativo@condologpro.local"
E2E_USER_PASSWORD="replace-with-local-test-password"
