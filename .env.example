DATABASE_URL="file:./dev.db"

# Supabase/Vercel cloud mode
# Use the pooled Supabase Postgres URL for DATABASE_URL in Vercel.
# Use DIRECT_URL for direct migrations/db push when Supabase provides it.
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
# NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[publishable-key]"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="[legacy-anon-key-only-if-needed]"
# SUPABASE_SERVICE_ROLE_KEY="[service-role-key-server-only]"
# SUPABASE_STORAGE_BUCKET="package-labels"

# Optional: link seeded operators to existing Supabase Auth user IDs (the JWT sub claim).
# SEED_ADMIN_AUTH_SUBJECT="[auth-user-uuid]"
# SEED_FRONT_DESK_AUTH_SUBJECT="[auth-user-uuid]"
# SEED_MANAGER_AUTH_SUBJECT="[auth-user-uuid]"
